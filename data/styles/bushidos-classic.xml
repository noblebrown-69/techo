<?xml version="1.0" encoding="UTF-8"?>
<!-- BushidOS Classic — washi cream + sumi ink palette for Techo (BushidOS).
     Derived from BushidOS src/gtk3/_colors.scss.
     Copyright © 2026 Noble Brown. License: GPL-2.0-or-later -->
<style-scheme id="bushidos-classic" name="BushidOS Classic" version="1.0">
  <author>Techo / BushidOS</author>
  <description>BushidOS Classic — washi cream + sumi ink.</description>

  <!-- Palette (from _colors-neon.scss) -->
  <color name="washi"         value="#efe6d2"/>
  <color name="paper"         value="#f8f3e7"/>
  <color name="ink"           value="#1c150f"/>
  <color name="sumi"          value="#241a12"/>
  <color name="indigo"        value="#2b3a67"/>
  <color name="vermilion"     value="#c8321e"/>
  <color name="gold"          value="#c9a44c"/>
  <color name="gold_deep"     value="#b38a2c"/>
  <color name="antique"       value="#a07a26"/>
  <color name="bronze"        value="#8a6a3a"/>
  <color name="wood"          value="#3b2618"/>
  <color name="border"        value="#b3a07c"/>
  <color name="pine"          value="#4f7a4a"/>
  <color name="select_fg"     value="#fbf6ea"/>

  <!-- Global -->
  <style name="text"                    foreground="ink" background="paper"/>
  <style name="selection"               foreground="select_fg" background="indigo"/>
  <style name="selection-unfocused"     foreground="ink" background="border"/>
  <style name="cursor"                  foreground="vermilion"/>
  <style name="secondary-cursor"        foreground="indigo"/>
  <style name="current-line"            background="washi"/>

  <!-- Line numbers -->
  <style name="line-numbers"            foreground="bronze" background="washi"/>
  <style name="current-line-number"     foreground="vermilion" background="washi" bold="true"/>

  <!-- Bracket matching -->
  <style name="bracket-match"           foreground="ink" background="gold" bold="true"/>
  <style name="bracket-mismatch"        foreground="select_fg" background="vermilion"/>

  <!-- Search / margin / spaces -->
  <style name="search-match"            foreground="ink" background="gold"/>
  <style name="right-margin"            foreground="border" background="border"/>
  <style name="draw-spaces"             foreground="border"/>

  <!-- Comments -->
  <style name="def:comment"             foreground="bronze" italic="true"/>

  <!-- Statements / types -->
  <style name="def:keyword"             foreground="indigo" bold="true"/>
  <style name="def:statement"           foreground="indigo" bold="true"/>
  <style name="def:type"                foreground="wood" bold="true"/>

  <!-- Strings / constants -->
  <style name="def:string"              foreground="vermilion"/>
  <style name="def:special-char"        foreground="antique"/>
  <style name="def:constant"            foreground="gold_deep"/>
  <style name="def:number"              foreground="gold_deep"/>
  <style name="def:boolean"             foreground="gold_deep"/>

  <!-- Identifiers / functions -->
  <style name="def:identifier"          foreground="indigo"/>
  <style name="def:function"            foreground="pine"/>

  <!-- Preprocessor / errors / notes -->
  <style name="def:preprocessor"        foreground="bronze"/>
  <style name="def:error"               foreground="vermilion" underline="error"/>
  <style name="def:note"                foreground="ink" background="gold" bold="true"/>

  <!-- Links / net -->
  <style name="def:net-address"         foreground="indigo" underline="single"/>

  <!-- Diff -->
  <style name="diff:added-line"         foreground="pine"/>
  <style name="diff:removed-line"       foreground="vermilion"/>
  <style name="diff:location"           foreground="indigo"/>

  <!-- Markup / emphasis -->
  <style name="def:emphasis"            italic="true"/>
  <style name="def:strong-emphasis"     bold="true"/>
  <style name="def:heading"             foreground="vermilion" bold="true"/>

</style-scheme>
