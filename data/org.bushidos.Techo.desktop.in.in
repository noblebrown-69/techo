[Desktop Entry]
Name=手帳 Techo
_GenericName=Text Editor
_Comment=Edit text files
Exec=techo %U
Terminal=false
Type=Application
StartupNotify=true
StartupWMClass=techo
MimeType=text/plain;application/x-zerosize;
Icon=accessories-text-editor
Categories=GTK;Utility;TextEditor;
Keywords=techo;text;editor;tabs;highlighting;code;multiple;files;pluggable;notepad;手帳;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=techo --new-window %U
